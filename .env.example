# OpenAI 兼容 API 配置
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 翻译设置
SOURCE_LANG=en
TARGET_LANG=chinese

# MinerU 设置
# pipeline = 快速、通用（推荐）
# hybrid-auto-engine = 精度更高、更慢（需 VLM 模型 ~2.4GB）
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_TIMEOUT=900
# cpu 或 cuda（需 CUDA 可用）
MINERU_DEVICE_MODE=cpu

# HuggingFace 缓存（Windows 禁用符号链接以避免权限错误）
HF_HUB_DISABLE_SYMLINKS=1
